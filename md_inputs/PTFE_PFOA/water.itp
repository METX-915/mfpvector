; TIP3P water — matches the OW/HW atomtypes that batch_run.py injects via EXTRA
[ moleculetype ]
; name  nrexcl
SOL     2

[ atoms ]
;  nr  type  resnr residue atom cgnr   charge      mass
    1    OW      1    SOL   OW    1   -0.834    15.99940
    2    HW      1    SOL  HW1    1    0.417     1.00800
    3    HW      1    SOL  HW2    1    0.417     1.00800

#ifdef FLEXIBLE
[ bonds ]
; i j funct    length   force.c.
  1 2    1     0.09572  502416.0
  1 3    1     0.09572  502416.0
[ angles ]
; i j k funct   angle    force.c.
  2 1 3    1   104.520     628.02
#else
[ settles ]
; OW funct doh     dhh
   1     1 0.09572 0.15139
[ exclusions ]
1 2 3
2 1 3
3 1 2
#endif
