; Steered MD to generate umbrella-sampling starting configurations.
;
; Pull distance: the reaction coordinate is the z distance between the slab
; centre of mass and the PFAS centre of mass.  The slab is ~3.5 nm thick in an
; 8 nm box, so its half-thickness is ~1.75 nm and the adsorbed state sits near
; a COM-COM distance of ~2 nm.  The largest physically meaningful separation is
; half the box beyond the slab centre (~4 nm) -- past that the PFAS is closer
; to the slab's periodic image than to the slab.  1.5 nm of pulling therefore
; spans the well and reaches a plateau well inside that limit.
; (The original 1000 ps / 5 nm would have pulled the molecule through the
;  periodic boundary and back into the slab from the other side.)
integrator               = md
dt                       = 0.002
nsteps                   = 150000          ; 300 ps at 0.005 nm/ps -> 1.5 nm
nstlist                  = 40
nstenergy                = 1000
nstxout-compressed       = 1000
cutoff-scheme            = Verlet
coulombtype              = PME
rcoulomb                 = 1.0
rvdw                     = 1.0
pbc                      = xyz
constraints              = h-bonds
constraint-algorithm     = lincs
tcoupl                   = V-rescale
tc-grps                  = System
tau-t                    = 0.1
ref-t                    = 300
pcoupl                   = C-rescale
pcoupltype               = semiisotropic   ; slab geometry: decouple z from xy
tau-p                    = 2.0
ref-p                    = 1.0 1.0
compressibility          = 4.5e-5 4.5e-5
gen-vel                  = no
pull                     = yes
pull-ngroups             = 2
pull-ncoords             = 1
pull-group1-name         = POL
pull-group2-name         = PFA
pull-coord1-type         = umbrella
pull-coord1-geometry     = distance
pull-coord1-dim          = N N Y
pull-coord1-groups       = 1 2
pull-coord1-start        = yes
pull-coord1-rate         = 0.005           ; nm ps^-1
pull-coord1-k            = 1000            ; kJ mol^-1 nm^-2
pull-nstxout             = 100
pull-nstfout             = 100
pull-pbc-ref-prev-step-com = yes
