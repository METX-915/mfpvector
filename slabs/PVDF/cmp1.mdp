integrator=md
dt=0.002
nsteps=500000
nstlist=20
nstxout-compressed=25000
cutoff-scheme=Verlet
coulombtype=PME
rcoulomb=1.0
rvdw=1.0
pbc=xyz
constraints=h-bonds
constraint-algorithm=lincs
tcoupl=V-rescale
tc-grps=System
tau-t=0.1
ref-t=300
pcoupl=C-rescale
pcoupltype=semiisotropic
tau-p=1.0
ref-p=1.0 200.0
compressibility=0 4.5e-5
gen-vel=yes
gen-temp=300
